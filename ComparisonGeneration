import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from matplotlib.lines import Line2D
import matplotlib.gridspec as gridspec

rootzone_file_path = '/content/SoilMoisture_Rootzone.csv'
surface_file_path = '/content/SoilMoisture_Surface.csv'
sm_surface_all_path = '/content/sm_surface_all.csv'
sm_rootzone_all_path = '/content/sm_rootzone_all.csv'

rootzone_data = pd.read_csv(rootzone_file_path)
surface_data = pd.read_csv(surface_file_path)

drypoint_sm_rootzone = rootzone_data['drypoint_sm_rootzone'].dropna()
wetpoint_sm_rootzone = rootzone_data['wetpoint_sm_rootzone'].dropna()

drypoint_sm_surface = surface_data['drypoint_sm_surface'].dropna()
wetpoint_sm_surface = surface_data['wetpoint_sm_surface'].dropna()

def remove_outliers(data):
    Q1 = data.quantile(0.25)
    Q3 = data.quantile(0.75)
    IQR = Q3 - Q1
    lower_bound = Q1 - 1.5 * IQR
    upper_bound = Q3 + 1.5 * IQR
    return data[(data >= lower_bound) & (data <= upper_bound)]

data1 = pd.read_csv(sm_surface_all_path)
data2 = pd.read_csv(sm_rootzone_all_path)

dry1_no_outliers = remove_outliers(data1['dry2'].dropna())
wet1_no_outliers = remove_outliers(data1['wet2'].dropna())
dry2_no_outliers = remove_outliers(data2['dry2'].dropna())
wet2_no_outliers = remove_outliers(data2['wet2'].dropna())

width_ratio1 = 2.5
width_ratio2 = 3.25

fig = plt.figure(figsize=(22, 7))
gs = gridspec.GridSpec(1, 2, width_ratios=[width_ratio1, width_ratio2])

ax1 = plt.subplot(gs[0])
ax2 = plt.subplot(gs[1])

def set_ax_properties(ax):
    ax.spines['top'].set_linewidth(2)
    ax.spines['right'].set_linewidth(2)
    ax.spines['bottom'].set_linewidth(2)
    ax.spines['left'].set_linewidth(2)
    ax.tick_params(axis='x', labelsize=20, width=2)
    ax.tick_params(axis='y', labelsize=20, width=2)

def plot_combined_boxplot(ax, dry1, wet1, dry2, wet2, title, ylabel):
    labels = ['Surface', 'Rootzone']
    box = ax.boxplot([wet1, dry1, wet2, dry2],
                     positions=[1, 1.5, 3, 3.5], widths=0.3, patch_artist=True,
                     boxprops=dict(linewidth=2), whiskerprops=dict(linewidth=2, color='black'),
                     capprops=dict(linewidth=2), medianprops=dict(linewidth=2, color='black'),
                     meanprops=dict(marker='o', markerfacecolor='green', markersize=12),
                     flierprops=dict(marker='o', color='black', markerfacecolor='none', markersize=10),
                     showmeans=True)

    colors = ['blue', 'red', 'blue', 'red']
    for patch, color in zip(box['boxes'], colors):
        patch.set_facecolor(color)
        patch.set_linewidth(2)

    ax.set_title(title, fontsize=20, fontweight='bold', fontname='Times New Roman')
    ax.set_ylabel(ylabel, fontsize=20, fontweight='bold', fontname='Times New Roman')
    ax.set_xticks([1.25, 3.25])
    ax.set_xticklabels(labels, fontsize=20, fontweight='bold', fontname='Times New Roman')

    legend_elements = [Line2D([0], [0], color='black', lw=2, label='1.5IQR Range'),
                       Line2D([0], [0], color='black', lw=2, label='Median Line'),
                       Line2D([0], [0], marker='o', color='green', markersize=12, label='Mean', linestyle='None'),
                       Line2D([0], [0], marker='o', color='black', markersize=10, label='Outliers', linestyle='None'),
                       Line2D([0], [0], marker='s', color='w', label='Wet', markerfacecolor='blue', markersize=12),
                       Line2D([0], [0], marker='s', color='w', label='Dry', markerfacecolor='red', markersize=12)]

    legend = ax.legend(handles=legend_elements, fontsize=12, frameon=True, loc='center', bbox_to_anchor=(0.85, 0.50))
    frame = legend.get_frame()
    frame.set_facecolor('white')
    frame.set_edgecolor('white')

    for i, (wet, dry) in enumerate([(wet1, dry1), (wet2, dry2)]):
        for j, data in enumerate([wet, dry]):
            upper = data.max()
            lower = data.min()
            mean = data.mean()
            position = 1 + 2.0 * i + 0.5 * j
            horizontal_offset = -0.3 if j == 0 else 0.3
            vertical_spacing = (upper - lower) / 15

            font_size = 12
            ax.text(position + horizontal_offset, upper + 0.2 * vertical_spacing, f'Upper:\n{upper:.2f}', horizontalalignment='center', color='blue', fontsize=font_size, fontweight='bold', fontname='Times New Roman')
            ax.text(position + horizontal_offset - 0.015, mean, f'Mean:\n{mean:.2f}', horizontalalignment='center', color='green', fontsize=font_size, fontweight='bold', fontname='Times New Roman')
            ax.text(position + horizontal_offset, lower - 0.5 * vertical_spacing, f'Lower:\n{lower:.2f}', horizontalalignment='center', color='blue', fontsize=font_size, fontweight='bold', fontname='Times New Roman')

plot_combined_boxplot(ax1, dry1_no_outliers, wet1_no_outliers, dry2_no_outliers, wet2_no_outliers, '(a)', r'Soil Moisture $\mathbf{(m^3/m^3)}$')
set_ax_properties(ax1)

sns.kdeplot(wetpoint_sm_rootzone, color='blue', linewidth=2, ax=ax2)
sns.kdeplot(drypoint_sm_rootzone, color='red', linewidth=2, ax=ax2)
sns.kdeplot(wetpoint_sm_surface, color='green', linewidth=2, ax=ax2)
sns.kdeplot(drypoint_sm_surface, color='orange', linewidth=2, ax=ax2)

ax2.axvline(wetpoint_sm_rootzone.mean(), color='blue', linestyle='--', linewidth=2, alpha=0.5)
ax2.axvline(drypoint_sm_rootzone.mean(), color='red', linestyle='--', linewidth=2, alpha=0.5)
ax2.axvline(wetpoint_sm_surface.mean(), color='green', linestyle='--', linewidth=2, alpha=0.5)
ax2.axvline(drypoint_sm_surface.mean(), color='orange', linestyle='--', linewidth=2, alpha=0.5)

ax2.set_title('(b)', fontsize=20, fontweight='bold', fontname='Times New Roman')
ax2.set_xlabel(r'Soil Moisture $\mathbf{(m^3/m^3)}$', fontsize=20, fontweight='bold', fontname='Times New Roman')
ax2.set_ylabel('Density', fontsize=20, fontweight='bold', fontname='Times New Roman')

plt.legend(['Wet (Rootzone)', 'Dry (Rootzone)', 'Wet (Surface)', 'Dry (Surface)'], fontsize=12)
set_ax_properties(ax2)
plt.subplots_adjust(wspace=0.3)
plt.show()
